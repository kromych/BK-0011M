# BK-0011M BOS: low memory and system calls (applies to BK-0011M listings).
# Source: BOS system programmer's manual 00015-01.32.01 (1990): §1.4 low
# memory, §2.3 and §3 system calls. Russian text in notes is quoted from it.

# Low memory used by BOS (vectors themselves are left numeric)
name 40 GOADDR ; start address for the monitor's G command
name 52 RETCOD ; low byte: return code of system calls
name 110 KBDPRG ; keyboard program vector (user termination routine)
name 114 PAGCPY ; copy of the last paging-register write
name 116 TAPCPY ; copy of the last tape-register write
name 166 EMTUSR ; EMT pseudo-vector: EMTs that BOS does not handle

# BOS system calls: JSR PC,@slot, or EMT n (slot = 140010 + 2n).
# Each slot in the table at 140010 holds the routine address.
name 140010 J$BINIT ; slot: BOS .BINIT, initialize BOS
name 150414 BINIT ; BOS .BINIT (EMT 0): initialize BOS (инициализация БОС)
emt 0 BINIT ; initialize BOS
name 140012 J$BEXIT ; slot: BOS .BEXIT, exit to the keyboard monitor
name 147712 BEXIT ; BOS .BEXIT (EMT 1): exit to the keyboard monitor (выход в клавиатурный монитор)
emt 1 BEXIT ; exit to the keyboard monitor
name 140014 J$BTRPS ; slot: BOS .BTRPS, intercept vector 4
name 147742 BTRPS ; BOS .BTRPS (EMT 2): intercept vector 4 (перехват 4 вектора)
emt 2 BTRPS ; intercept vector 4
name 140016 J$BTIM ; slot: BOS .BTIM, control the timer
name 150070 BTIM ; BOS .BTIM (EMT 3): control the timer (управление таймером)
emt 3 BTIM ; control the timer
name 140020 J$BEMT ; slot: BOS .BEMT, control EMT handling
name 152202 BEMT ; BOS .BEMT (EMT 4): control EMT handling (управление обработкой EMT)
emt 4 BEMT ; control EMT handling
name 150164 BRESV ; target of the reserved slots ("зарезервировано")
name 140030 J$BMEM ; slot: BOS .BMEM, read memory status
name 150474 BMEM ; BOS .BMEM (EMT 10): read memory status (чтение состояния памяти)
emt 10 BMEM ; read memory status
name 140032 J$BTEST ; slot: BOS .BTEST, read page status
name 150504 BTEST ; BOS .BTEST (EMT 11): read page status (чтение статуса страницы)
emt 11 BTEST ; read page status
name 140034 J$BPAGE ; slot: BOS .BPAGE, map a RAM/ROM page
name 150514 BPAGE ; BOS .BPAGE (EMT 12): map a RAM/ROM page (подключение страницы ОЗУ/ПЗУ)
emt 12 BPAGE ; map a RAM/ROM page
name 140036 J$BWORK ; slot: BOS .BWORK, set/read the working page
name 150530 BWORK ; BOS .BWORK (EMT 13): set/read the working page (назначение/чтение рабочей страницы)
emt 13 BWORK ; set/read the working page
name 140040 J$BGETW ; slot: BOS .BGETW, read a word from the working page
name 150540 BGETW ; BOS .BGETW (EMT 14): read a word from the working page (чтение слова из рабочей страницы)
emt 14 BGETW ; read a word from the working page
name 140042 J$BGETB ; slot: BOS .BGETB, read a byte from the working page
name 150564 BGETB ; BOS .BGETB (EMT 15): read a byte from the working page (чтение байта из рабочей страницы)
emt 15 BGETB ; read a byte from the working page
name 140044 J$BPUTW ; slot: BOS .BPUTW, write a word to the working page
name 150612 BPUTW ; BOS .BPUTW (EMT 16): write a word to the working page (запись слова в рабочую страницу)
emt 16 BPUTW ; write a word to the working page
name 140046 J$BPUTB ; slot: BOS .BPUTB, write a byte to the working page
name 150654 BPUTB ; BOS .BPUTB (EMT 17): write a byte to the working page (запись байта в рабочую страницу)
emt 17 BPUTB ; write a byte to the working page
name 140050 J$BMOVE ; slot: BOS .BMOVE, move an array of words
name 151140 BMOVE ; BOS .BMOVE (EMT 20): move an array of words (пересылка массива слов)
emt 20 BMOVE ; move an array of words
name 140052 J$BMOVB ; slot: BOS .BMOVB, move an array of bytes
name 151156 BMOVB ; BOS .BMOVB (EMT 21): move an array of bytes (пересылка массива байтов)
emt 21 BMOVB ; move an array of bytes
name 140054 J$BJSR ; slot: BOS .BJSR, call a subroutine in the working page
name 151006 BJSR ; BOS .BJSR (no EMT): call a subroutine in the working page (вызов подпрограммы из рабочей страницы)
name 140056 J$BJMP ; slot: BOS .BJMP, jump to the working page, no return
name 151114 BJMP ; BOS .BJMP (EMT 23): jump to the working page, no return (переход в рабочую страницу без возврата)
emt 23 BJMP ; jump to the working page, no return
name 140070 J$BKINI ; slot: BOS .BKINI, initialize the keyboard driver
name 146704 BKINI ; BOS .BKINI (EMT 30): initialize the keyboard driver (инициализация драйвера клавиатуры)
emt 30 BKINI ; initialize the keyboard driver
name 140072 J$BKSET ; slot: BOS .BKSET, set keyboard driver mode
name 146752 BKSET ; BOS .BKSET (EMT 31): set keyboard driver mode (установка режима драйвера клавиатуры)
emt 31 BKSET ; set keyboard driver mode
name 140074 J$BKGET ; slot: BOS .BKGET, read keyboard driver mode
name 146764 BKGET ; BOS .BKGET (EMT 32): read keyboard driver mode (чтение режима драйвера клавиатуры)
emt 32 BKGET ; read keyboard driver mode
name 140076 J$BTTIN ; slot: BOS .BTTIN, read a character, waiting
name 147550 BTTIN ; BOS .BTTIN (EMT 33): read a character, waiting (ввод символа с ожиданием)
emt 33 BTTIN ; read a character, waiting
name 140100 J$BINKEY ; slot: BOS .BINKEY, read a character, not waiting
name 147406 BINKEY ; BOS .BINKEY (EMT 34): read a character, not waiting (ввод символа без ожидания)
emt 34 BINKEY ; read a character, not waiting
name 140102 J$BGLIN ; slot: BOS .BGLIN, read a line with editing
name 151336 BGLIN ; BOS .BGLIN (EMT 35): read a line with editing (ввод строки с редактированием)
emt 35 BGLIN ; read a line with editing
name 140104 J$BEDIT ; slot: BOS .BEDIT, edit an existing line
name 151266 BEDIT ; BOS .BEDIT (EMT 36): edit an existing line (редактирование существующей строки)
emt 36 BEDIT ; edit an existing line
name 140106 J$BKRES ; slot: BOS .BKRES, clear the keyboard buffer
name 147636 BKRES ; BOS .BKRES (EMT 37): clear the keyboard buffer (сброс буфера клавиатуры)
emt 37 BKRES ; clear the keyboard buffer
name 140110 J$BSFUN ; slot: BOS .BSFUN, set function keys
name 147672 BSFUN ; BOS .BSFUN (EMT 40): set function keys (установка функциональных клавиш)
emt 40 BSFUN ; set function keys
name 140112 J$BGFUN ; slot: BOS .BGFUN, read function keys
name 147702 BGFUN ; BOS .BGFUN (EMT 41): read function keys (чтение функциональных клавиш)
emt 41 BGFUN ; read function keys
name 140130 J$BTINI ; slot: BOS .BTINI, initialize the screen driver
name 143456 BTINI ; BOS .BTINI (EMT 50): initialize the screen driver (инициализация драйвера экрана)
emt 50 BTINI ; initialize the screen driver
name 140132 J$BTSET ; slot: BOS .BTSET, set screen driver mode
name 143446 BTSET ; BOS .BTSET (EMT 51): set screen driver mode (установка режима драйвера экрана)
emt 51 BTSET ; set screen driver mode
name 140134 J$BTGET ; slot: BOS .BTGET, read screen driver mode
name 143434 BTGET ; BOS .BTGET (EMT 52): read screen driver mode (чтение режима драйвера экрана)
emt 52 BTGET ; read screen driver mode
name 140136 J$BSCOL ; slot: BOS .BSCOL, set colors
name 143274 BSCOL ; BOS .BSCOL (EMT 53): set colors (установка цветов)
emt 53 BSCOL ; set colors
name 140140 J$BGCOL ; slot: BOS .BGCOL, read colors
name 143414 BGCOL ; BOS .BGCOL (EMT 54): read colors (чтение цветов)
emt 54 BGCOL ; read colors
name 140142 J$BPAL ; slot: BOS .BPAL, set/read the palette
name 150000 BPAL ; BOS .BPAL (EMT 55): set/read the palette (установка/чтение палитры)
emt 55 BPAL ; set/read the palette
name 140144 J$BBUF ; slot: BOS .BBUF, switch screen buffers
name 143466 BBUF ; BOS .BBUF (EMT 56): switch screen buffers (переключение буферов экрана)
